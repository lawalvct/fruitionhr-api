APP_NAME=FruitionHR
APP_ENV=local
APP_KEY=base64:UF2MBFGU95scO1tv9EqGFH3CWa/Vn016ZicESLVT87Y=
APP_DEBUG=true
APP_URL=http://api.fruitionhr.test

FRONTEND_URL=http://app.fruitionhr.test:3000
SANCTUM_STATEFUL_DOMAINS=fruitionhr.test,app.fruitionhr.test,admin.fruitionhr.test,fruitionhr.test:3000,app.fruitionhr.test:3000,admin.fruitionhr.test:3000,localhost:3000,app.localhost:3000,admin.localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fruitionhr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty = host-only cookie, scoped to whatever host issued it. Required for
# local dev: Chrome silently rejects `Domain=.localhost` (single-label hosts
# can't take a leading-dot cookie domain), so browsers were never receiving a
# session/XSRF cookie at all against *.localhost. Next.js rewrites make API
# calls same-origin per subdomain (see fruitionhr-web/.env.local), so a
# host-only cookie already covers app.localhost/admin.localhost individually.
# With *.fruitionhr.test vhosts: .fruitionhr.test (multi-label, works fine).
# Production: .fruitionhr.com
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Branding shown in every email's header/footer. Defaults live in config/mail.php;
# override MAIL_BRAND_LOGO_URL if the logo is served from a CDN rather than APP_URL.
MAIL_BRAND_PRODUCT="FruitionHR"
MAIL_BRAND_TAGLINE="Empowering Your Workforce"
# MAIL_BRAND_LOGO_URL=
MAIL_BRAND_WEBSITE_URL="https://fruitionhr.com"
MAIL_BRAND_SUPPORT_EMAIL="support@fruitionhr.com"
MAIL_BRAND_COMPANY="FruitionHR"
MAIL_BRAND_ADDRESS="Lagos, Nigeria"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment gateways (FruitionHR platform credentials — never tenant-supplied).
BILLING_DEFAULT_GATEWAY=paystack
